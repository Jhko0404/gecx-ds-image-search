# ==========================================
# GECX Layout Parser Search API 설정 환경변수
# ==========================================

# GCP 프로젝트 ID (필수)
# 예: my-customer-gcp-project
PROJECT_ID=

# Cloud Run 배포 리전 (기본값: us-central1)
REGION=us-central1

# Discovery Engine 데이터스토어 ID (필수)
# 예: layout-parser_1781649684122
DATASTORE_ID=

# Discovery Engine 데이터스토어 위치 (기본값: global)
LOCATION=global

# Discovery Engine 컬렉션 ID (기본값: default_collection)
COLLECTION_ID=default_collection

# Discovery Engine Serving Config ID (기본값: default_search)
SERVING_CONFIG_ID=default_search

# Cloud Run 서비스 이름 (기본값: layout-parser-search-api)
SERVICE_NAME=layout-parser-search-api

# GECX 서비스 에이전트 이메일 (선택 - 미입력 시 스크립트에서 자동 조회)
# 예: service-123456789012@gcp-sa-ces.iam.gserviceaccount.com
GECX_SERVICE_ACCOUNT=
