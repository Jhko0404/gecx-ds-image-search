# ==============================================================================
# [고객사 환경 설정] GECX Layout Parser Search API 환경변수 정의서
# ==============================================================================
# 각 항목의 확인 방법(GCP 콘솔 및 CLI)을 참고하여 고객사 환경에 맞게 입력하세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GCP 프로젝트 ID (필수)
# ------------------------------------------------------------------------------
# [확인 방법]
# - GCP 콘솔: 화면 상단 프로젝트 선택 드롭다운 클릭 -> 'ID' 열의 값 복사 (프로젝트 이름이 아닌 고유 ID)
# - gcloud CLI: 터미널에서 `gcloud config get-value project` 실행
# [예시] my-customer-prod-project
PROJECT_ID=

# ------------------------------------------------------------------------------
# 2. Cloud Run 배포 리전 (선택 - 기본값: us-central1)
# ------------------------------------------------------------------------------
# [확인 방법]
# - 고객사 GCP 리소스 또는 CXAS 앱이 위치한 권장 리전 선택
# - 국내 리전 사용 시: asia-northeast3 (서울) / 기본 권장: us-central1
# [예시] us-central1 또는 asia-northeast3
REGION=us-central1

# ------------------------------------------------------------------------------
# 3. Discovery Engine 데이터스토어 ID (필수)
# ------------------------------------------------------------------------------
# [확인 방법]
# - GCP 콘솔: 'Vertex AI Search' (또는 'Agent Builder') 검색 -> 좌측 메뉴 'Data Stores' 클릭
#             -> 사전에 구축한 Layout Parser 데이터스토어 클릭 -> 상단 'Data store ID' 복사
# - gcloud CLI: 
#   curl -H "Authorization: Bearer $(gcloud auth print-access-token)" \
#     "https://discoveryengine.googleapis.com/v1beta/projects/[PROJECT_ID]/locations/global/collections/default_collection/dataStores"
# [예시] purifier-manual-layout-parser 또는 layout-parser_1781649684122
DATASTORE_ID=

# ------------------------------------------------------------------------------
# 4. 데이터스토어 위치 (LOCATION) (기본값: global)
# ------------------------------------------------------------------------------
# [확인 방법]
# - Vertex AI Search 콘솔의 Data Store 상세 정보에서 'Location' 확인 (대부분 global)
# [예시] global, us, eu
LOCATION=global

# ------------------------------------------------------------------------------
# 5. 컬렉션 ID (COLLECTION_ID) (기본값: default_collection)
# ------------------------------------------------------------------------------
# [확인 방법]
# - Discovery Engine의 기본 컬렉션을 사용하는 경우 'default_collection' 유지
COLLECTION_ID=default_collection

# ------------------------------------------------------------------------------
# 6. 서빙 설정 ID (SERVING_CONFIG_ID) (기본값: default_search)
# ------------------------------------------------------------------------------
# [확인 방법]
# - 데이터스토어의 기본 검색 서빙 설정을 사용하는 경우 'default_search' 유지
SERVING_CONFIG_ID=default_search

# ------------------------------------------------------------------------------
# 7. Cloud Run 서비스 이름 (선택 - 기본값: layout-parser-search-api)
# ------------------------------------------------------------------------------
# [설명] 고객사에서 원하는 Cloud Run 서비스 식별 이름
SERVICE_NAME=layout-parser-search-api

# ------------------------------------------------------------------------------
# 8. GECX 서비스 에이전트 계정 (선택 - 미입력 시 deploy.sh에서 자동 계산)
# ------------------------------------------------------------------------------
# [확인 방법]
# - GCP 콘솔: IAM 및 관리자 > IAM > 'Google 제공 역할 부여 포함' 체크 후 'gcp-sa-ces' 검색
# - 형식: service-[GCP프로젝트번호]@gcp-sa-ces.iam.gserviceaccount.com
# - 비워둘 경우 deploy.sh 스크립트가 프로젝트 번호를 조회하여 자동으로 권한을 부여합니다.
GECX_SERVICE_ACCOUNT=
